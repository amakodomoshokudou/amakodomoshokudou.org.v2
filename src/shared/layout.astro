---
import { Image } from "astro:assets";
import icon from "./assets/icon.svg";
import name from "./assets/name.svg";
import type { BreadcrumbItems } from "./breadcrumb";
import Breadcrumb from "./breadcrumb.astro";
import { site, summary } from "./const";
import CopyButton from "./copy-button.astro";
import Menu from "./menu.astro";

export type Props = {
  breadcrumb?: BreadcrumbItems;
};

const props = Astro.props;

const pathname = Astro.url.pathname;

const navItems = [
  { href: "/", text: "トップページ", isCurrent: pathname === "/" },
  {
    href: "/about/",
    text: "私たちについて",
    isCurrent: pathname === "/about/",
  },
  {
    href: "/cafes/",
    text: "尼崎のこども食堂",
    isCurrent: pathname === "/cafes/",
  },
  {
    href: "/charity/",
    text: "こども食堂への支援",
    isCurrent: pathname === "/charity/",
  },
  {
    href: "/start-cafe/",
    text: "こども食堂の立ち上げ",
    isCurrent: pathname === "/start-cafe/",
  },
  {
    href: summary.facebook.value,
    text: "お知らせ（Facebook）",
    isExternal: true,
  },
];
---

<div class="layout">
  <header class="layout_header">
    <div class="layout_header_body">
      <p class="layout_logo_body">
        <a href="/" class="layout_logo">
          <span class="sr-only">{site.title}</span>
          <Image src={icon} alt="" class="layout_logo_icon" />
          <Image src={name} alt="" class="layout_logo_name" />
        </a>
      </p>
      <Menu>
        <div class="layout_menu">
          <nav aria-label="グローバルナビゲーション">
            <ul class="nav_list">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.isExternal ? "_blank" : undefined}
                    aria-current={item.isCurrent ? "page" : undefined}
                    class="nav_link"
                  >
                    {item.text}
                    {item.isExternal && <span role="img" aria-label="外部リンク" class="external_icon"></span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="contact_box">
            <p class="contact_heading">お問い合わせはこちら</p>
            <p class="contact_mail">
              {summary.mail.value}
            </p>
            <CopyButton copyText={summary.mail.value}>メールアドレスをコピー</CopyButton>
          </div>
        </div>
      </Menu>
      <nav class="desktop_nav" aria-label="グローバルナビゲーション">
        <ul class="desktop_nav_list">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.isExternal ? "_blank" : undefined}
                aria-current={item.isCurrent ? "page" : undefined}
                class="nav_link"
              >
                {item.text}
                {item.isExternal && <span role="img" aria-label="外部リンク" class="external_icon"></span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="desktop_contact_box">
        <p class="desktop_contact_heading">お問い合わせはこちら</p>
        <p class="desktop_contact_mail">
          {summary.mail.value}
        </p>
        <CopyButton size="sm" copyText={summary.mail.value} label>メールアドレス</CopyButton>
      </div>
    </div>
  </header>
  <div class="layout_body">
    <main class="layout_main">
      <slot />
    </main>
    {props.breadcrumb && (
      <div class="layout_breadcrumb">
        <Breadcrumb items={props.breadcrumb} />
      </div>
    )}
    <footer class="layout_footer">
      <div class="layout_footer_body">
        <p class="footer_text">
          <a href="/privacy-policy/" class="footer_link">プライバシーポリシー</a>
        </p>
        <p class="footer_text">
          <small>© 2024 尼崎こども食堂ネットワーク</small>
        </p>
      </div>
    </footer>
  </div>
</div>

<style>
  .layout {
    position: relative;
    display: grid;
    min-block-size: 100svb;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    grid-template-rows: auto 1fr;

    @media (width >= 64rem) {
      block-size: 100svb;
      grid-template-columns: var(--spacing-220) minmax(0, 1fr);
      grid-template-rows: repeat(1, minmax(0, 1fr));
    }
  }

  .layout_header {
    position: sticky;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: minmax(var(--spacing-20), 1fr) minmax(0, var(--spacing-932)) minmax(var(--spacing-20), 1fr);
    background-color: var(--color-primary-background);
    border-block-end: 1px solid var(--color-secondary-border);

    @media (width >= 64rem) {
      grid-column: 1;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      /* Safari 26 / Chrome 135 未満向けのフォールバック */
      overflow-y: auto;
      overflow-block: auto;
      border-inline-end: 1px solid var(--color-secondary-border);
      border-block-end-width: 0;
    }
  }

  .layout_header_body {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-8);
    justify-content: space-between;
    padding-block: var(--spacing-8);

    @media (width >= 64rem) {
      grid-column: 1 / -1;
      display: grid;
      align-content: start;
      gap: 0;
      justify-content: start;
      padding-inline: var(--spacing-12);
      padding-block: var(--spacing-20);
    }
  }

  .layout_logo_body {
    min-inline-size: 0;
  }

  .layout_logo {
    color: var(--color-primary-text);
    text-decoration-line: none;
    display: flex;
    place-items: center;
    column-gap: var(--spacing-4);

    @media (width >= 64rem) {
      flex-direction: column;
    }
  }

  .layout_logo_icon {
    min-inline-size: 0;
    inline-size: var(--spacing-52);

    @media (width >= 64rem) {
      inline-size: var(--spacing-84);
    }
  }

  .layout_logo_name {
    min-inline-size: 0;
    inline-size: var(--spacing-84);

    @media (width >= 64rem) {
      inline-size: var(--spacing-136);
    }

    @media (prefers-color-scheme: dark) {
      filter: invert(1);
    }
  }

  .layout_menu {
    display: grid;
    row-gap: var(--spacing-20);
  }

  .nav_list {
    display: grid;
    row-gap: var(--spacing-8);
    padding: 0;
    list-style: none;
  }

  .nav_link {
    color: var(--color-primary-text);
    display: grid;
    border-radius: var(--radius-xl);
    padding-inline: var(--spacing-12);
    padding-block: var(--spacing-8);
    font-size: var(--text-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-md);
    text-decoration-line: none;

    &[aria-current="page"] {
      background-color: var(--color-secondary-background);
    }

    &[target="_blank"] {
      grid-template-columns: auto 1fr;
      align-items: center;
    }
  }

  .external_icon {
    inline-size: 1em;
    block-size: 1em;
    background-color: currentColor;
    -webkit-mask: url("/assets/icons/open_in_new.svg") center / cover no-repeat;
    mask: url("/assets/icons/open_in_new.svg") center / cover no-repeat;
  }

  .contact_box {
    display: grid;
    row-gap: var(--spacing-12);
    border: 1px solid var(--color-secondary-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-12);
  }

  .contact_heading {
    font-size: var(--text-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-md);
  }

  .contact_mail {
    font-size: var(--text-md);
    font-weight: var(--font-weight-normal);
    line-height: var(--leading-md);
  }

  .desktop_contact_box {
    display: none;
    row-gap: var(--spacing-12);
    border: 1px solid var(--color-secondary-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-12);

    @media (width >= 64rem) {
      display: grid;
      margin-block-start: var(--spacing-20);
    }
  }

  .desktop_contact_heading {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    font-weight: var(--font-weight-bold);
  }

  .desktop_contact_mail {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-normal);
    line-height: var(--leading-xs);
  }

  .desktop_nav {
    display: none;

    @media (width >= 64rem) {
      display: block;
      margin-block-start: var(--spacing-20);
    }

    & .nav_link {
      font-size: var(--text-sm);
      font-weight: var(--font-weight-bold);
      line-height: var(--leading-sm);
    }
  }

  .desktop_nav_list {
    display: grid;
    row-gap: var(--spacing-4);
    padding: 0;
    list-style: none;
  }

  .layout_body {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(var(--spacing-20), 1fr) minmax(0, var(--spacing-932)) minmax(var(--spacing-20), 1fr);
    grid-template-rows: 1fr auto;

    @media (width >= 64rem) {
      grid-column: 2;
      grid-template-columns: minmax(var(--spacing-32), 1fr) minmax(0, var(--spacing-932)) minmax(var(--spacing-32), 1fr);
      /* Safari 26 / Chrome 135 未満向けのフォールバック */
      overflow-y: auto;
      overflow-block: auto;
    }
  }

  .layout_main {
    grid-column: 1 / -1;
  }

  .layout_breadcrumb {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    padding-block: var(--spacing-20);

    /* Breadcrumb コンポーネントの要素にはスコープが付かないため :global() を使う */
    & > :global(*) {
      grid-column: 2;
    }
  }

  .layout_footer {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    padding-block: var(--spacing-20);
    border-block-start: 1px solid var(--color-secondary-border);
  }

  .layout_footer_body {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: var(--spacing-20);
    row-gap: var(--spacing-12);
  }

  .footer_text {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-normal);
    line-height: var(--leading-sm);
  }

  .footer_link {
    color: var(--color-primary-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-normal);
    line-height: var(--leading-sm);
    text-decoration-line: underline;
  }
</style>
