---
import { Image } from "astro:assets";
import icon from "./assets/icon.svg";
import name from "./assets/name.svg";
import Breadcrumb from "./breadcrumb.astro";
import type { BreadcrumbItems } from "./breadcrumb-type";
import { site, summary } from "./const";
import CopyButton from "./copy-button.astro";
import Menu from "./menu.astro";

export type Props = {
  breadcrumb?: BreadcrumbItems;
};

const props = Astro.props;

const pathname = Astro.url.pathname;

const navItems = [
  { href: "/", text: "トップページ", isCurrent: pathname === "/" },
  {
    href: "/about/",
    text: "私たちについて",
    isCurrent: pathname === "/about/",
  },
  {
    href: "/cafes/",
    text: "尼崎のこども食堂",
    isCurrent: pathname === "/cafes/",
  },
  {
    href: "/charity/",
    text: "こども食堂への支援",
    isCurrent: pathname === "/charity/",
  },
  {
    href: "/start-cafe/",
    text: "こども食堂の立ち上げ",
    isCurrent: pathname === "/start-cafe/",
  },
  {
    href: summary.facebook.value,
    text: "お知らせ（Facebook）",
    isExternal: true,
  },
];
---

<div
  class="relative grid min-h-svh grid-cols-1 grid-rows-[auto_1fr] lg:h-svh lg:grid-cols-[var(--spacing-220)_minmax(0,1fr)] lg:grid-rows-1"
>
  <header
    class="border-b-secondary-border bg-primary-background lg:border-r-secondary-border sticky inset-x-0 top-0 z-10 grid grid-cols-[minmax(var(--spacing-20),1fr)_minmax(0,var(--spacing-932))_minmax(var(--spacing-20),1fr)] border-b lg:col-1 lg:grid-cols-1 lg:overflow-y-auto lg:border-r lg:border-b-0"
  >
    <div
      class="col-2 flex flex-wrap items-center justify-between py-8 lg:col-span-full lg:grid lg:content-start lg:justify-start lg:px-12 lg:py-20"
    >
      <p>
        <a href="/" class="flex place-items-center gap-x-4 lg:flex-col">
          <span class="sr-only">{site.title}</span>
          <Image src={icon} alt="" class="w-full max-w-52 lg:max-w-84" />
          <Image src={name} alt="" class="w-full max-w-84 lg:max-w-136 dark:invert" />
        </a>
      </p>
      <Menu>
        <div class="grid gap-y-20">
          <nav aria-label="グローバルナビゲーション">
            <ul class="grid gap-y-8">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.isExternal ? "_blank" : undefined}
                    aria-current={item.isCurrent ? "page" : undefined}
                    class={[
                      "aria-[current=page]:bg-secondary-background grid rounded-xl px-12 py-8 font-bold",
                      item.isExternal && "grid-cols-[auto_1fr] items-center",
                    ].join(" ")}
                  >
                    {item.text}
                    {item.isExternal && (
                      <span
                        role="img"
                        aria-label="外部リンク"
                        class="size-[1em] mask-[url(/assets/icons/open_in_new.svg)] bg-[currentColor] mask-cover mask-center mask-no-repeat"
                      ></span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="border-secondary-border grid gap-y-12 rounded-xl border p-12">
            <p class="font-bold">お問い合わせはこちら</p>
            <p class="">
              {summary.mail.value}
            </p>
            <CopyButton copyText={summary.mail.value}>メールアドレスをコピー</CopyButton>
          </div>
        </div>
      </Menu>
      <nav class="hidden lg:mt-20 lg:block" aria-label="グローバルナビゲーション">
        <ul class="grid gap-y-4">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.isExternal ? "_blank" : undefined}
                aria-current={item.isCurrent ? "page" : undefined}
                class={[
                  "text-sm/sm aria-[current=page]:bg-secondary-background grid rounded-xl px-12 py-8 font-bold",
                  item.isExternal && "grid-cols-[auto_1fr] items-center",
                ].join(" ")}
              >
                {item.text}
                {item.isExternal && (
                  <span
                    role="img"
                    aria-label="外部リンク"
                    class="size-[1em] mask-[url(/assets/icons/open_in_new.svg)] bg-[currentColor] mask-cover mask-center mask-no-repeat"
                  ></span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="border-secondary-border hidden gap-y-12 rounded-xl border p-12 lg:mt-20 lg:grid">
        <p class="text-sm/sm font-bold">お問い合わせはこちら</p>
        <p class="text-xs/xs">
          {summary.mail.value}
        </p>
        <CopyButton size="sm" copyText={summary.mail.value} label>メールアドレス</CopyButton>
      </div>
    </div>
  </header>
  <div
    class="col-span-full grid grid-cols-[minmax(var(--spacing-20),1fr)_minmax(0,var(--spacing-932))_minmax(var(--spacing-20),1fr)] grid-rows-[1fr_auto] lg:col-2 lg:grid-cols-[minmax(var(--spacing-32),1fr)_minmax(0,var(--spacing-932))_minmax(var(--spacing-32),1fr)] lg:overflow-y-auto"
  >
    <main class="col-span-full">
      <slot />
    </main>
    {props.breadcrumb && (
      <div class="col-span-full grid grid-cols-subgrid py-20 *:col-2">
        <Breadcrumb items={props.breadcrumb} />
      </div>
    )}
    <footer class="border-t-secondary-border col-span-full grid grid-cols-subgrid border-t py-20">
      <div class="col-2 flex flex-wrap justify-between gap-x-20 gap-y-12">
        <p class="text-sm/sm">
          <a href="/privacy-policy/" class="underline">プライバシーポリシー</a>
        </p>
        <p class="text-sm/sm">
          <small>© 2024 尼崎こども食堂ネットワーク</small>
        </p>
      </div>
    </footer>
  </div>
</div>
