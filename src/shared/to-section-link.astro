---
export type Props = {
  target: string;
  text: string;
};

const { target, text } = Astro.props;
---

<a
  href={`#${target}`}
  class="border-b-primary-border text-sm/sm inline-grid grid-cols-[auto_auto] items-center gap-x-8 border-b pb-4 font-bold"
>
  {text}
  <span
    role="img"
    aria-label="hidden"
    class="size-[1em] bg-[currentColor] mask-[url(/assets/icons/arrow_down.svg)] mask-cover mask-center mask-no-repeat"
  ></span>
</a>
