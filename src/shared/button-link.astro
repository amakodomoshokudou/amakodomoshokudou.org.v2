---
export type Props = {
  href: string;
  text: string;
};

const { href, text } = Astro.props;
---

<a href={href} class="button_link">
  {text}
  <span aria-hidden="true" role="img" class="button_link_icon"></span>
</a>

<style>
  .button_link {
    color: var(--color-primary-text);
    display: inline-grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: var(--spacing-8);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    background-color: var(--color-primary-background);
    padding-inline: var(--spacing-12);
    padding-block: var(--spacing-8);
    font-size: var(--text-md);
    font-weight: var(--font-weight-normal);
    line-height: var(--leading-md);
    text-decoration-line: none;
  }

  .button_link_icon {
    inline-size: 1em;
    block-size: 1em;
    background-color: currentColor;
    -webkit-mask: url("/assets/icons/arrow_forward.svg") center / cover no-repeat;
    mask: url("/assets/icons/arrow_forward.svg") center / cover no-repeat;
  }
</style>
