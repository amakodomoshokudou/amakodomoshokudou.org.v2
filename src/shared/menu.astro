---
---

<div data-id="menu">
  <button type="button" data-id="menu-open-button" aria-expanded="false" class="menu_open_button">
    <span role="img" class="menu_open_icon"></span>
    メニュー
  </button>
  <dialog data-id="menu-dialog" aria-label="メニュー" class="menu_dialog">
    <div class="menu_body">
      <div class="menu_content">
        <button type="button" data-id="menu-close-button" class="menu_close_button">
          <span role="img" aria-hidden="true" class="menu_close_icon"></span>
          閉じる
        </button>
        <slot />
      </div>
    </div>
  </dialog>
</div>

<script>
  const menuList = document.querySelectorAll<HTMLDivElement>("[data-id=menu]");

  for (const menu of menuList) {
    const menuOpenButton = menu.querySelector<HTMLButtonElement>("[data-id=menu-open-button]");
    const menuCloseButton = menu.querySelector<HTMLButtonElement>("[data-id=menu-close-button]");
    const menuDialog = menu.querySelector<HTMLDialogElement>("[data-id=menu-dialog]");

    if (
      menuDialog instanceof HTMLDialogElement === false ||
      menuOpenButton instanceof HTMLButtonElement === false ||
      menuCloseButton instanceof HTMLButtonElement === false
    ) {
      throw new Error("DOMが正しく設定されていません。");
    }

    menuOpenButton.addEventListener("click", () => {
      menuDialog.showModal();
    });

    menuCloseButton.addEventListener("click", () => {
      menuDialog.close();
    });

    menuDialog.addEventListener("click", (event) => {
      if (event.target === menuDialog) {
        menuDialog.close();
      }
    });
  }
</script>

<style>
  .menu_open_button {
    display: inline-grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: var(--spacing-8);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    padding-inline: var(--spacing-12);
    padding-block: var(--spacing-8);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    font-weight: var(--font-weight-bold);

    @media (width >= 64rem) {
      display: none;
    }
  }

  .menu_open_icon {
    inline-size: 1.25em;
    block-size: 1.25em;
    background-color: currentColor;
    -webkit-mask: url("/assets/icons/menu.svg") center / cover no-repeat;
    mask: url("/assets/icons/menu.svg") center / cover no-repeat;
  }

  .menu_dialog {
    inline-size: 100%;
    block-size: 100%;
    max-inline-size: 100%;
    max-block-size: 100%;
    background-color: rgb(0 0 0 / 0.8);
  }

  .menu_body {
    padding: var(--spacing-20);
    background-color: var(--color-primary-background);
    border-block-end: 1px solid var(--color-secondary-border);
  }

  .menu_content {
    display: grid;
    row-gap: var(--spacing-20);
    max-inline-size: var(--spacing-576);
    margin-inline: auto;
  }

  .menu_close_button {
    display: flex;
    align-items: center;
    justify-content: center;
    column-gap: var(--spacing-8);
    border: 1px solid var(--color-primary-border);
    background-color: var(--color-primary-background);
    border-radius: var(--radius-xl);
    padding-inline: var(--spacing-12);
    padding-block: var(--spacing-8);
    font-size: var(--text-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-md);
  }

  .menu_close_icon {
    inline-size: 1.25em;
    block-size: 1.25em;
    background-color: currentColor;
    -webkit-mask: url("/assets/icons/close.svg") center / cover no-repeat;
    mask: url("/assets/icons/close.svg") center / cover no-repeat;
  }
</style>
