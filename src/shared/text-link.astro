---
export type Props = {
  href: string;
  target?: "_blank";
};

const props = Astro.props;
---

<a href={props.href} target={props.target} class="text_link">
  <slot />
  {props.target === "_blank" && <span role="img" aria-label="外部リンク" class="text_link_icon"></span>}
</a>

<style>
  .text_link {
    color: var(--color-link);
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .text_link_icon {
    display: inline-block;
    inline-size: 1em;
    block-size: 1em;
    vertical-align: -2px;
    background-color: var(--color-link);
    -webkit-mask: url("/assets/icons/open_in_new.svg") center / cover no-repeat;
    mask: url("/assets/icons/open_in_new.svg") center / cover no-repeat;
  }
</style>
