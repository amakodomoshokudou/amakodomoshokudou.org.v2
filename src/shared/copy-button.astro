---
export type Props = {
  copyText: string;
  successText?: string;
  label?: boolean;
  size?: "sm" | "md";
};

const { copyText, successText = "コピーしました", size = "md", label = false } = Astro.props;
---

<span class="copy_button" data-id="copy-button" data-copy-text={copyText} data-success-text={successText}>
  <button type="button" class="copy_button_button" data-size={size}>
    <slot />
    <span role="img" aria-label={label ? "をコピー" : undefined} class="copy_button_icon"></span>
  </button>
  <span aria-live="assertive" data-open="false" class="copy_notify"></span>
</span>

<script>
  const copyButtonList = document.querySelectorAll<HTMLSpanElement>("[data-id=copy-button]");

  for (const copyButton of copyButtonList) {
    const button = copyButton.querySelector<HTMLButtonElement>("button");
    const notify = copyButton.querySelector<HTMLSpanElement>("[aria-live=assertive]");

    if (!button) {
      throw new Error("button is not found");
    }
    if (!notify) {
      throw new Error("notify is not found");
    }

    const $copyText = copyButton.dataset.copyText;
    const $successText = copyButton.dataset.successText;

    if (!$copyText) {
      throw new Error("copyText is not found");
    }

    if (!$successText) {
      throw new Error("successText is not found");
    }

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText($copyText);
        notify.textContent = $successText;
        notify.dataset.open = "true";
      } catch {
        notify.textContent = "コピーに失敗しました";
        notify.dataset.open = "true";
      } finally {
        setTimeout(() => {
          notify.textContent = "";
          notify.dataset.open = "false";
        }, 3000);
      }
    });
  }
</script>

<style>
  .copy_button {
    display: inline-grid;
    inline-size: fit-content;
  }

  .copy_button_button {
    color: var(--color-primary-text);
    display: inline-grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    background-color: var(--color-primary-background);
    grid-area: 1 / 1;
    font-size: var(--text-md);
    font-weight: var(--font-weight-normal);
    line-height: var(--leading-md);

    &[data-size="sm"] {
      column-gap: var(--spacing-4);
      padding-inline: var(--spacing-8);
      padding-block: var(--spacing-4);
      font-size: var(--text-sm);
      line-height: var(--leading-sm);
    }

    &[data-size="md"] {
      column-gap: var(--spacing-8);
      padding-inline: var(--spacing-12);
      padding-block: var(--spacing-8);
      font-size: var(--text-md);
      line-height: var(--leading-md);
    }
  }

  .copy_button_icon {
    inline-size: 1em;
    block-size: 1em;
    background-color: currentColor;
    -webkit-mask: url("/assets/icons/content_copy.svg") center / cover no-repeat;
    mask: url("/assets/icons/content_copy.svg") center / cover no-repeat;
  }

  .copy_notify {
    color: var(--color-primary-text);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-normal);
    line-height: var(--leading-xs);
    background-color: var(--color-tertiary-background);
    isolation: isolate;
    align-self: flex-start;
    justify-self: end;
    border-radius: var(--radius-xs);
    grid-area: 1 / 1;

    &[data-open="true"] {
      border: 1px solid var(--color-secondary-border);
      padding: var(--spacing-4);
    }
  }
</style>
