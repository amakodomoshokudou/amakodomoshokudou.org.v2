---
import type { BreadcrumbItems } from "./breadcrumb";

export type Props = {
  items: BreadcrumbItems;
};

const props = Astro.props;
---

<nav aria-label="現在位置">
  <ol>
    {props.items.map((item) => {
      if ("href" in item) {
        return (
          <li class="breadcrumb_item">
            <a href={item.href} class="breadcrumb_link">
              {item.title}
            </a>
            <span role="img" aria-label="の中の" class="breadcrumb_separator" />
          </li>
        );
      }

      return (
        <li class="breadcrumb_item" aria-current="page">
          {item.title}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumb_item {
    display: inline;
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .breadcrumb_link {
    text-decoration-line: underline;
    text-underline-offset: 2px;
  }

  .breadcrumb_separator {
    display: inline-block;
    inline-size: 1em;
    block-size: 1em;
    margin-right: var(--spacing-4);
    margin-left: var(--spacing-8);
    background-color: currentColor;
    vertical-align: -2px;
    -webkit-mask: url("/assets/icons/chevron_right.svg") center / cover no-repeat;
    mask: url("/assets/icons/chevron_right.svg") center / cover no-repeat;
  }
</style>
