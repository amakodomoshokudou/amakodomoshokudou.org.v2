---
import Document from "../shared/layout/document.astro";
import Layout from "../shared/layout/layout.astro";
import type { BreadcrumbItems } from "../shared/ui/breadcrumb-type";
import PrivacyPolicyPage from "../views/privacy-policy/privacy-policy-page.astro";

const title = "プライバシーポリシー";

const breadcrumb: BreadcrumbItems = [
  {
    title: "トップページ",
    href: "/",
  },
  {
    title,
  },
];
---

<Document title={title}>
  <Layout breadcrumb={breadcrumb}>
    <PrivacyPolicyPage title={title} />
  </Layout>
</Document>
