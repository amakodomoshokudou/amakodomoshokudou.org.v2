---
import type { BreadcrumbItems } from "../shared/breadcrumb";
import Document from "../shared/document.astro";
import Layout from "../shared/layout.astro";
import NotFoundPage from "../views/not-found/not-found-page.astro";

const title = "指定されたページは見つかりませんでした";

const breadcrumb: BreadcrumbItems = [
  {
    title: "トップページ",
    href: "/",
  },
  {
    title,
  },
];
---

<Document title={title}>
  <Layout breadcrumb={breadcrumb}>
    <NotFoundPage title={title} />
  </Layout>
</Document>
