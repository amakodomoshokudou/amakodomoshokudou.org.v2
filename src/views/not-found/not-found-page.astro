---
import TextLink from "../../shared/text-link.astro";

export type Props = {
  title: string;
};

const { title } = Astro.props;
---

<div class="not_found_page">
  <div class="not_found_header">
    <h1 class="not_found_header_title">
      {title}
    </h1>
    <div class="prose not_found_message">
      <p>指定されたページはすでに削除もしくはURLが変更された可能性があります。</p>
      <p>
        大変お手数ですが、URLをご確認の上、再度お試しいただくか、
        <TextLink href="/">トップページ</TextLink>
        からお探しください。
      </p>
    </div>
  </div>
</div>

<style>
  .not_found_page {
    display: grid;
    grid-template-columns:
      minmax(var(--spacing-20), 1fr)
      minmax(0, var(--spacing-932))
      minmax(var(--spacing-20), 1fr);

    @media (width >= 64rem) {
      grid-template-columns:
        minmax(var(--spacing-32), 1fr)
        minmax(0, var(--spacing-932))
        minmax(var(--spacing-32), 1fr);
    }
  }

  .not_found_header {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    border-block-start: 8px solid var(--color-accent);
    row-gap: var(--spacing-20);
    padding-block: var(--spacing-32);

    & > * {
      grid-column: 2;
    }

    @media (width >= 64rem) {
      row-gap: var(--spacing-32);
      padding-block: var(--spacing-52);
    }
  }

  .not_found_header_title {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    font-weight: var(--font-weight-bold);

    @media (width >= 64rem) {
      font-size: var(--text-3xl);
      line-height: var(--leading-3xl);
    }
  }

  .not_found_message {
    display: grid;
    row-gap: var(--spacing-20);
  }
</style>
