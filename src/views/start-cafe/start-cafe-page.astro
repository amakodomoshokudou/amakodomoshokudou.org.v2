---
import { summary } from "../../shared/const";
import CopyButton from "../../shared/copy-button.astro";
import DownloadLink from "../../shared/download-link.astro";
import FlowItem from "../../shared/flow-item.astro";
import Heading from "../../shared/heading.astro";
import NextStep from "../../shared/next-step.astro";
import TextLink from "../../shared/text-link.astro";
import ToSectionLink from "../../shared/to-section-link.astro";

export type Props = {
  title: string;
};

const { title } = Astro.props;
---

<div class="start_cafe_page">
  <div class="start_cafe_header">
    <h1 class="start_cafe_header_title">{title}</h1>
    <div class="start_cafe_document">
      <p class="start_cafe_document_heading">PDF版の資料</p>
      <p>
        <DownloadLink
          href="/media/documents/amakodomoshokudou-leaflet.pdf"
          filename="amakodomoshokudou-leaflet"
          text="尼崎こども食堂ネットワーク・リーフレット"
        />
      </p>
    </div>
    <ol class="start_cafe_links">
      <li>
        <ToSectionLink target="flow" text="立ち上げの流れ" />
      </li>
      <li>
        <ToSectionLink target="mailing-list" text="メーリングリスト" />
      </li>
    </ol>
  </div>
  <div class="start_cafe_sections">
    <section class="section">
      <Heading id="flow">立ち上げの流れ</Heading>
      <FlowItem step={1} title="まずは気持ちを整理!">
        <p>なぜ活動しようと思ったのか、どんな食堂にしたいのか、気持ちを整理してみましょう。</p>
        <p>
          活動を続けていくためにも、仲間は大事です。<br />
          目的や方向性を共有しながら進めていきましょう。
        </p>
      </FlowItem>
      <NextStep />
      <FlowItem step={2} title="社協むすぶグループへ相談">
        <p>
          活動地区の「
          <TextLink href="http://amasyakyo.jp/syakyo_index/access/" target="_blank">
            むすぶグループ(尼崎市社会福祉協議会の支部)
          </TextLink>
          」に相談しましょう。
        </p>
        <p>
          地域とのつながり作りや、イベント保険の案内、他のこども食堂の見学など、立ち上げるまで、立ち上げてからのお手伝いをしてくれます。
        </p>
      </FlowItem>
      <NextStep />
      <FlowItem step={3} title="他のこども食堂を見学してみよう!">
        <p>実際に活動している現場を見学することで、より具体的な計画が立てやすくなります。</p>
        <p>
          会食やお弁当配布、フードパントリーなど、実施形態はさまざまです。
          <br />
          自分たちに合った方法を見つけましょう。
        </p>
      </FlowItem>
      <NextStep />
      <FlowItem step={4} title="保健所に相談しよう!">
        <p>
          食品衛生法上の手続きについて、保健所に相談しましょう。
          <br />
          詳細は
          <TextLink href="https://www.city.amagasaki.hyogo.jp/sangyo/zigyousya/insyokuten/1025137.html" target="_blank">
            尼崎市のホームページ
          </TextLink>
          をご覧ください。
        </p>
      </FlowItem>
      <NextStep />
      <FlowItem step={5} title="まずは1回やってみよう!">
        <p>
          当日のスケジュールや、今後の運営のおおまかな段取りなどが分かり、また、地域のみなさんに活動を知ってもらう機会にもなります。
        </p>
      </FlowItem>
    </section>
    <section class="prose section">
      <Heading id="mailing-list">メーリングリストに登録することができます</Heading>
      <p>寄付食材や研修会の情報等、活動を続けていくために役立つ情報をお届けします。</p>
      <p>尼崎こども食堂ネットワーク事務局まで、登録希望のご連絡をお願いします。</p>
      <div class="mail_box">
        <p class="mail_box_heading">連絡先のメールアドレス</p>
        <p class="mail_box_address">{summary.mail.value}</p>
        <p>
          <CopyButton copyText={summary.mail.value}>メールアドレスをコピー</CopyButton>
        </p>
      </div>
    </section>
  </div>
</div>

<style>
  .start_cafe_page {
    display: grid;
    grid-template-columns:
      minmax(var(--spacing-20), 1fr)
      minmax(0, var(--spacing-932))
      minmax(var(--spacing-20), 1fr);

    @media (width >= 64rem) {
      grid-template-columns:
        minmax(var(--spacing-32), 1fr)
        minmax(0, var(--spacing-932))
        minmax(var(--spacing-32), 1fr);
    }
  }

  .start_cafe_header {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    border-block-start: 8px solid var(--color-accent);
    row-gap: var(--spacing-20);
    padding-block: var(--spacing-32);

    & > * {
      grid-column: 2;
    }

    @media (width >= 64rem) {
      row-gap: var(--spacing-32);
      padding-block: var(--spacing-52);
    }
  }

  .start_cafe_header_title {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    font-weight: var(--font-weight-bold);

    @media (width >= 64rem) {
      font-size: var(--text-3xl);
      line-height: var(--leading-3xl);
    }
  }

  .start_cafe_document {
    display: grid;
    row-gap: var(--spacing-12);
    border: 1px solid var(--color-secondary-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-12);

    @media (width >= 64rem) {
      padding: var(--spacing-20);
    }
  }

  .start_cafe_document_heading {
    font-size: var(--text-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-md);
  }

  .start_cafe_links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--spacing-20);
    row-gap: var(--spacing-12);
  }

  .start_cafe_sections {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    background-color: var(--color-secondary-background);
    row-gap: var(--spacing-52);
    padding-block: var(--spacing-32);

    & > * {
      grid-column: 2;
    }

    @media (width >= 64rem) {
      row-gap: var(--spacing-84);
      padding-block: var(--spacing-52);
    }
  }

  .section {
    display: grid;
    row-gap: var(--spacing-20);
  }

  .mail_box {
    display: grid;
    row-gap: var(--spacing-12);
    background-color: var(--color-primary-background);
    border: 1px solid var(--color-secondary-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-12);

    @media (width >= 64rem) {
      padding: var(--spacing-20);
    }
  }

  .mail_box_heading {
    font-size: var(--text-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-md);
  }

  .mail_box_address {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-normal);
    line-height: var(--leading-sm);
  }
</style>
