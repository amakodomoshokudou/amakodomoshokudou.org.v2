---
import type { Area, Cafe } from "../../modules/cafe/model";
import DownloadLink from "../../shared/download-link.astro";
import AreaFilter from "./area-filter.astro";
import CafeList from "./cafe-list.astro";
import Pagination from "./pagination.astro";

export type Props = {
  isFirstPage: boolean;
  currentPage: number;
  lastPage: number;
  cafes: Cafe[];
  allAreas: Area[];
};

const { isFirstPage, currentPage, lastPage, cafes, allAreas } = Astro.props;
---

<div class="cafes_page">
  <div class="cafes_header">
    <div class="cafes_heading">
      <h1 class="cafes_heading_title">
        <span class="cafes_heading_title_label">尼崎のこども食堂</span>
        {!isFirstPage && <span class="cafes_heading_title_page">{currentPage}ページ目</span>}
      </h1>
      <p class="cafes_description">掲載許可の取れたこども食堂のみ掲載しています。</p>
    </div>
    <div class="cafes_document">
      <p class="cafes_document_heading">PDF版の資料</p>
      <p>
        <DownloadLink
          href="/media/documents/amakodomoshokudou-map.pdf"
          filename="amakodomoshokudou-map"
          text="尼崎こども食堂マップ"
        />
      </p>
    </div>
  </div>
  <div class="cafes_sections">
    <AreaFilter areas={allAreas} />
    <CafeList cafes={cafes} />
    {lastPage > 1 && <Pagination current={currentPage} total={lastPage} baseUrl="/cafes/" />}
  </div>
</div>

<style>
  .cafes_page {
    display: grid;
    grid-template-columns:
      minmax(var(--spacing-20), 1fr)
      minmax(0, var(--spacing-932))
      minmax(var(--spacing-20), 1fr);

    @media (width >= 64rem) {
      grid-template-columns:
        minmax(var(--spacing-32), 1fr)
        minmax(0, var(--spacing-932))
        minmax(var(--spacing-32), 1fr);
    }
  }

  .cafes_header {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    border-block-start: 8px solid var(--color-accent);
    row-gap: var(--spacing-20);
    padding-block: var(--spacing-32);

    & > * {
      grid-column: 2;
    }

    @media (width >= 64rem) {
      row-gap: var(--spacing-32);
      padding-block: var(--spacing-52);
    }
  }

  .cafes_heading {
    display: grid;
    row-gap: var(--spacing-20);
  }

  .cafes_heading_title {
    display: grid;
    justify-items: start;
    row-gap: var(--spacing-12);
    font-size: var(--text-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-md);
  }

  .cafes_heading_title_label {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-2xl);

    @media (width >= 64rem) {
      font-size: var(--text-3xl);
      line-height: var(--leading-3xl);
    }
  }

  .cafes_heading_title_page {
    background-color: var(--color-secondary-background);
    border-radius: var(--radius-xs);
    padding-inline: var(--spacing-8);
    padding-block: var(--spacing-4);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-xs);
  }

  .cafes_description {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-normal);
    line-height: var(--leading-sm);
  }

  .cafes_document {
    display: grid;
    row-gap: var(--spacing-12);
    border: 1px solid var(--color-secondary-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-12);

    @media (width >= 64rem) {
      padding: var(--spacing-20);
    }
  }

  .cafes_document_heading {
    font-size: var(--text-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-md);
  }

  .cafes_sections {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    background-color: var(--color-secondary-background);
    row-gap: var(--spacing-32);
    padding-block: var(--spacing-32);

    /* AreaFilter / CafeList / Pagination の要素にはスコープが付かないため :global() を使う */
    & > :global(*) {
      grid-column: 2;
    }

    @media (width >= 64rem) {
      row-gap: var(--spacing-52);
      padding-block: var(--spacing-52);
    }
  }
</style>
