---
export type Props = {
  total: number;
  current: number;
  baseUrl: `${string}/`;
};

const props = Astro.props;
---

<nav aria-label="ページ送り">
  <ol class="pagination_list">
    {Array.from({ length: props.total }).map((_, i) => {
      const page = i + 1;
      // propsとして渡されるbaseUrlは末尾にスラッシュがある
      const href = page === 1 ? props.baseUrl : `${props.baseUrl}${page}/`;
      const isCurrent = page === props.current;

      return (
        <li>
          <a href={href} aria-current={isCurrent ? "page" : undefined} class="pagination_link">
            {page}
          </a>
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .pagination_list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-12);
    padding: 0;
    list-style: none;
  }

  .pagination_link {
    color: var(--color-primary-text);
    display: inline-grid;
    place-content: center;
    inline-size: var(--spacing-52);
    block-size: var(--spacing-52);
    background-color: var(--color-primary-background);
    border: 1px solid var(--color-primary-border);
    border-radius: 50%;
    font-size: var(--text-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-md);
    text-decoration-line: none;

    &[aria-current] {
      background-color: var(--color-secondary-background);
    }
  }
</style>
