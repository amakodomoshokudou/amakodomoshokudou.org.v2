---
import Activities from "../../shared/activities.astro";
import DownloadLink from "../../shared/download-link.astro";
import Heading from "../../shared/heading.astro";
import ToSectionLink from "../../shared/to-section-link.astro";
import Histories from "./histories.astro";
import Overview from "./overview.astro";

export type Props = {
  title: string;
};

const { title } = Astro.props;
---

<div class="about_page">
  <div class="about_header">
    <h1 class="about_header_title">{title}</h1>
    <div class="about_document">
      <p class="about_document_heading">PDF版の資料</p>
      <p>
        <DownloadLink
          href="/media/documents/amakodomoshokudou-leaflet.pdf"
          filename="amakodomoshokudou-leaflet"
          text="尼崎こども食堂ネットワーク・リーフレット"
        />
      </p>
    </div>
    <ol class="about_links">
      <li>
        <ToSectionLink target="philosophy" text="理念" />
      </li>
      <li>
        <ToSectionLink target="activities" text="活動内容" />
      </li>
      <li>
        <ToSectionLink target="histories" text="発足の経緯" />
      </li>
      <li>
        <ToSectionLink target="overview" text="団体概要" />
      </li>
    </ol>
  </div>

  <div class="about_sections">
    <section class="prose section">
      <Heading id="philosophy">理念</Heading>
      <h3 class="philosophy_title">アマのこども食堂が身近な地域の居場所であり続けられるように</h3>
      <p>
        尼崎市では2015年「こども食堂」第1号が立ち上がり、その後、多くの地域住民がそれぞれの地域で「こどもたちのために何かしたい」という思いで、活動を始めていきました。
      </p>
      <p>
        身近な「地域のこどもの居場所」として、自慢の料理をふるまったり、いっしょに遊んだり騒いだり、時には保護者やこどものグチやお話を聞いたり、それぞれの思いを大切に、活動しています。
      </p>
      <p>
        「尼崎こども食堂ネットワーク」は、アマのこども食堂が、アマのこどもたちにとって「身近な地域の居場所」であり続けられるように、中間支援的な役割を担う団体として活動しています。
      </p>
    </section>
    <section class="section">
      <Heading id="activities">活動内容</Heading>
      <Activities />
    </section>
    <section class="section">
      <Heading id="histories">発足の経緯</Heading>
      <Histories />
    </section>
    <section class="section">
      <Heading id="overview">団体概要</Heading>
      <Overview />
    </section>
    <div class="logo_credit">
      <p class="logo_credit_heading">ロゴ作成者（夢遊病）</p>
      <p class="logo_credit_text">
        今回、子供食堂のロゴを担当させて頂きました、夢遊病です。<br />
        僕は個人で起業して自分と同じ境遇の方に寄り添うことがしたいと日々活動しているので、子供食堂に関わることができて、すごくうれしいです。
      </p>
    </div>
  </div>
</div>

<style>
  .about_page {
    display: grid;
    grid-template-columns:
      minmax(var(--spacing-20), 1fr)
      minmax(0, var(--spacing-932))
      minmax(var(--spacing-20), 1fr);

    @media (width >= 64rem) {
      grid-template-columns:
        minmax(var(--spacing-32), 1fr)
        minmax(0, var(--spacing-932))
        minmax(var(--spacing-32), 1fr);
    }
  }

  .about_header {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    border-block-start: 8px solid var(--color-accent);
    row-gap: var(--spacing-20);
    padding-block: var(--spacing-32);

    & > * {
      grid-column: 2;
    }

    @media (width >= 64rem) {
      row-gap: var(--spacing-32);
      padding-block: var(--spacing-52);
    }
  }

  .about_header_title {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    font-weight: var(--font-weight-bold);

    @media (width >= 64rem) {
      font-size: var(--text-3xl);
      line-height: var(--leading-3xl);
    }
  }

  .about_document {
    display: grid;
    row-gap: var(--spacing-12);
    border: 1px solid var(--color-secondary-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-12);

    @media (width >= 64rem) {
      padding: var(--spacing-20);
    }
  }

  .about_document_heading {
    font-size: var(--text-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-md);
  }

  .about_links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--spacing-20);
    row-gap: var(--spacing-12);
    padding: 0;
    list-style: none;
  }

  .about_sections {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    background-color: var(--color-secondary-background);
    row-gap: var(--spacing-52);
    padding-block: var(--spacing-32);

    & > * {
      grid-column: 2;
    }

    @media (width >= 64rem) {
      row-gap: var(--spacing-84);
      padding-block: var(--spacing-52);
    }
  }

  .section {
    display: grid;
    row-gap: var(--spacing-20);
  }

  .philosophy_title {
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    font-weight: var(--font-weight-bold);
    text-wrap: balance;

    @media (width >= 64rem) {
      font-size: var(--text-xl);
      line-height: var(--leading-xl);
    }
  }

  .logo_credit {
    display: grid;
    row-gap: var(--spacing-12);
    background-color: var(--color-primary-background);
    border: 1px solid var(--color-secondary-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-12);

    @media (width >= 64rem) {
      padding: var(--spacing-20);
    }
  }

  .logo_credit_heading {
    font-size: var(--text-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-md);
  }

  .logo_credit_text {
    max-inline-size: var(--spacing-640);
    font-size: var(--text-md);
    font-weight: var(--font-weight-normal);
    line-height: var(--leading-loose);
  }
</style>
