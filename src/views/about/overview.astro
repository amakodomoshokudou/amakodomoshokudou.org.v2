---
import { summary } from "../../shared/const";
import TextLink from "../../shared/text-link.astro";
---

<dl class="overview">
  <div class="overview_item">
    <dt class="overview_term">
      {summary.name.title}
    </dt>
    <dd class="overview_description">
      {summary.name.value}
    </dd>
  </div>
  <div class="overview_item">
    <dt class="overview_term">
      {summary.constituent.title}
    </dt>
    <dd class="overview_description">
      <ul class="overview_list">
        {summary.constituent.value.map((item) => <li>{item}</li>)}
      </ul>
    </dd>
  </div>
  <div class="overview_item">
    <dt class="overview_term">
      {summary.establish.title}
    </dt>
    <dd class="overview_description">
      <time datetime={summary.establish.value.datetime}>{summary.establish.value.display}</time>
    </dd>
  </div>
  <div class="overview_item">
    <dt class="overview_term">
      {summary.representative.title}
    </dt>
    <dd class="overview_description">
      {summary.representative.value}
    </dd>
  </div>
  <div class="overview_item">
    <dt class="overview_term">
      {summary.location.title}
    </dt>
    <dd class="overview_description">
      {`〒${summary.location.value.postalCode}`}
      <br />
      {summary.location.value.address}
    </dd>
  </div>
  <div class="overview_item">
    <dt class="overview_term">
      {summary.facebook.title}
    </dt>
    <dd class="overview_description">
      <TextLink href={summary.facebook.value} target="_blank">
        {summary.facebook.value}
      </TextLink>
    </dd>
  </div>
</dl>

<style>
  .overview {
    container-type: inline-size;
  }

  .overview_item {
    display: grid;
    row-gap: var(--spacing-12);
    border-radius: var(--radius-md);
    padding-block: var(--spacing-12);

    &:nth-child(odd) {
      background-color: var(--color-primary-background);
    }

    @container (width >= 40rem) {
      grid-template-columns: var(--spacing-136) 1fr;
    }
  }

  .overview_term {
    padding-inline: var(--spacing-20);

    @container (width >= 40rem) {
      padding-inline-end: 0;
    }
  }

  .overview_description {
    padding-inline: var(--spacing-20);
  }

  .overview_list {
    display: grid;
    row-gap: var(--spacing-8);
    padding-inline-start: var(--spacing-20);
    list-style-type: disc;
  }
</style>
