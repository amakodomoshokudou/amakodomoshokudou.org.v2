---
export type Props = {
  href: string;
  text: string;
};

const { href, text } = Astro.props;
---

<a
  href={href}
  class="border-primary-border bg-primary-background inline-grid grid-cols-[1fr_auto] items-center gap-x-8 rounded-xl border px-12 py-8"
>
  {text}
  <span
    aria-hidden="true"
    role="img"
    class="size-[1em] bg-[currentColor] mask-[url(/icons/arrow_forward.svg)] mask-cover mask-center mask-no-repeat"
  ></span>
</a>
