---
export type Props = {
  href: string;
  filename: string;
  text: string;
};

const { href, filename, text } = Astro.props;
---

<a
  href={href}
  download={filename}
  class="border-primary-border text-md/md inline-grid grid-cols-[1fr_auto] items-center gap-x-8 rounded-xl border px-12 py-8"
>
  {text}
  <span
    role="img"
    aria-label="をダウンロード"
    class="size-[1em] bg-[currentColor] mask-[url(/assets/icons/download.svg)] mask-cover mask-center mask-no-repeat"
  ></span>
</a>
