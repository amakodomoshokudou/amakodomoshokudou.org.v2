---
export type Props = {
  href: string;
  target?: "_blank";
};

const props = Astro.props;
---

<a href={props.href} target={props.target} class="text-link underline decoration-1 underline-offset-2">
  <slot />
  {props.target === "_blank" && (
    <span
      role="img"
      aria-label="外部リンク"
      class="inline-block size-[1em] mask-[url(/icons/open_in_new.svg)] bg-link mask-cover mask-center mask-no-repeat align-[-2px]"
    ></span>
  )}
</a>
