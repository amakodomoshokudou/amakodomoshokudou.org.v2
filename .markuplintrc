{
  "extends": [
    "markuplint:recommended"
  ],
  "nodeRules": [
    {
      "selector": "link[rel=\"sitemap\"]",
      "rules": {
        "no-invalid-attr-value": {
          "options": {
            "allowAttrs": [
              {
                "name": "rel",
                "value": {
                  "enum": [
                    "sitemap"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
